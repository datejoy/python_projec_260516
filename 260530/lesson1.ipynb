    "# list [] 符號建立法 ex:[34, 62, 38, 67, 11]\n",
    "# list 建立後可修改內容\n",
    "# idex\n",
    "score = [73, 28, 55]\n",
    "# 中括號 subScript\n",
    "print(score[0])\n",
    "score[0] = 100;\n",
    "print(score)\n",
    "\n",
    "\n",
    "# tuple () 符號建立\n",
    "# tuple 建立後不可修改內容 => read only\n",
    "# 使用時機: 暫存\n",
